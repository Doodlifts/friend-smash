# ── Friend Smash environment ────────────────────────────────────────────────
# Copy to .env.local. Nothing here is a private key — the app never signs or
# spends. All RF balances are SIMULATED.

# HMAC key for sessions, sign-in nonces and anti-cheat run tokens (required).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCORE_SIGNING_SECRET=

# Database. Local dev: embedded Postgres, no server needed:
#   DATABASE_URL=pglite:.data/pglite
# Hosted preview: a pooled Postgres URL (e.g. Neon). Apply db/schema.sql once
# with `npm run db:setup`.
DATABASE_URL=pglite:.data/pglite
DATABASE_URL_UNPOOLED=

# Optional: Robinhood chain RPC for server-side ownership + signature checks.
# Defaults to FriendSDK's public RPC.
RF_RPC_URL=

# Comma-separated WALLET addresses allowed into /admin.
ADMIN_WALLETS=

# Simulated-economy switches (see lib/rf/economy-rules.ts).
DAILY_BONUS_ENABLED=1
RUN_REWARD_ENABLED=
